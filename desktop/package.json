{
  "name": "dreamycafe-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "DreamyCafe Windows POS shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dreamycafe.pos",
    "productName": "DreamyCafe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../public/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
