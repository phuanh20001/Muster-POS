# Copy to .env and fill in. Never commit the filled-in file.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:pass@host:5432/dreamycafe

# Thermal printer IPs (Epson network, port 9100).
PRINTER_FRONT_IP=192.168.1.20
PRINTER_KITCHEN_IP=192.168.1.21
PRINTER_PORT=9100

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=aud

# Square (in-person terminal — switchable provider)
# SQUARE_ENV: "sandbox" (default) or "production"
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=EAAAxxx
SQUARE_LOCATION_ID=Lxxxxxxxxxxxxx
SQUARE_CURRENCY=AUD
SQUARE_WEBHOOK_SIGNATURE_KEY=xxx
# Optional fallback if no reader row is configured in the DB:
# SQUARE_DEVICE_ID=

# GST for accounting reports. Defaults: 10% inclusive if unset.
# GST_RATE=0.10
# GST_INCLUSIVE=true

# Public zone — must match the Cloudflare Transform Rule that SETs x-dreamy-zone.
PUBLIC_ZONE_SECRET=generate-a-long-random-string

# Signing key for the manager_session JWT. Required — the app refuses to start without it.
JWT_SECRET=generate-a-long-random-string

# Backup failure alerting (optional). healthchecks.io ping URLs.
BACKUP_HEALTHCHECK_URL=
MAINTENANCE_HEALTHCHECK_URL=
RESTORE_DRILL_HEALTHCHECK_URL=

# Receipt / tax-invoice details printed on dockets.
DOCKET_BRAND_NAME=Dreamy Cafe
RECEIPT_ADDRESS=12 Example Street, Sampleton, ACT 2600
RECEIPT_PHONE=(02) 1234 5678
RECEIPT_EMAIL=hello@dreamy-cafe.example
RECEIPT_ABN=00 000 000 000
