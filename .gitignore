# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# generated service worker — source lives at scripts/sw.template.js
/public/sw.js

# production
/build

# misc
.DS_Store
*.pem
/logs/
/tools/nssm/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# database
prisma/*.db
prisma/*.db-journal
prisma/**/*.db
prisma/**/*.db-journal

# database backups (contain live data — never commit)
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent-tool local caches (canonical skills live in /skills/)
/.agents/
/.continue/
/.claude/skills/
/.cursor/mcp.json
/.codegraph/

# electron desktop shell
/desktop/node_modules
/desktop/dist

# uploaded product images (shop-local)
/public/uploads/products/*
!/public/uploads/products/.gitkeep
